<UserControl x:Class="TheCup_Presentation.Views.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TheCup_Presentation.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">

    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource SectionTitle}"
                           Text="{StaticResource Teams_Title}" />
                <TextBlock Style="{StaticResource SectionSubtitle}"
                           Text="{StaticResource Teams_Subtitle}" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource Brush.AccentPrimary}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding TournamentName}" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12"
                               Text="{StaticResource Tournament_StatusLabel}" />
                    <TextBlock Margin="6,0,0,0"
                               Foreground="{StaticResource Brush.AccentPrimary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding StatusDisplay}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           FontSize="12"
                           Text="{Binding InfoMessage}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,12,0"
                        Content="{StaticResource Teams_ConfirmTeams}"
                        Command="{Binding ConfirmTeamsCommand}" />
                
                <Button Style="{StaticResource SecondaryButton}"
                        Content="{StaticResource Teams_Refresh}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,24,0,16"
                Style="{StaticResource TournamentCardBorder}"
                Padding="16"
                Visibility="{Binding ShowConfirmSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="{StaticResource Teams_NewTeamLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,12,0"
                             Style="{StaticResource DarkTextBox}"
                             Text="{Binding NewTeamName, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1"
                            Margin="0,0,12,0"
                            Style="{StaticResource PrimaryButton}"
                            Content="{StaticResource Teams_AddTeam}"
                            Command="{Binding AddTeamCommand}" />

                    
                </Grid>

                
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,16"
                Style="{StaticResource TournamentCardBorder}"
                Padding="16"
                Visibility="{Binding ShowConfirmedSection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="{StaticResource Brush.AccentPrimary}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="{StaticResource Teams_ConfirmedTitle}" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource SectionSubtitle}"
                               Text="{StaticResource Teams_ConfirmedMessage}" />
                </StackPanel>

                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}"
                        Content="{StaticResource Teams_EditTeams}"
                        Command="{Binding EditTeamsCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,0,0,16"
                Style="{StaticResource TournamentCardBorder}"
                Padding="16"
                Visibility="{Binding ShowActivateSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}"
                           FontSize="18"
                           Text="{StaticResource Tournament_ActivateTitle}" />
                <TextBlock Margin="0,6,0,16"
                           Style="{StaticResource SectionSubtitle}"
                           Text="{Binding ActivationHint}" />
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButton}"
                        Content="{StaticResource Tournament_Activate}"
                        Command="{Binding ActivateTournamentCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="0,0,0,16"
                Style="{StaticResource TournamentCardBorder}"
                Padding="16"
                Visibility="{Binding ShowActiveBanner, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="{StaticResource Brush.AccentPrimary}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{StaticResource Tournament_ActiveBanner}" />
        </Border>

        <Grid Grid.Row="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TournamentCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource DarkTextBox}"
                                             IsEnabled="{Binding CanModify}"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="{StaticResource Teams_Rename}"
                                            Command="{Binding CommitRenameCommand}" />

                                    <Button Grid.Column="2"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DangerButton}"
                                            Content="{StaticResource Teams_Remove}"
                                            Command="{Binding RemoveTeamCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{StaticResource Teams_EmptyTitle}"
                           Style="{StaticResource SectionTitle}"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="{StaticResource Teams_EmptyMessage}"
                           Style="{StaticResource SectionSubtitle}"
                           TextAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
