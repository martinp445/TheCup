<UserControl x:Class="TheCup_Presentation.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TheCup_Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource SectionTitle}"
               Text="{StaticResource Games_Title}" />
                <TextBlock Style="{StaticResource SectionSubtitle}"
               Text="{StaticResource Games_Subtitle}" />
                <TextBlock Margin="0,8,0,0"
               Foreground="{StaticResource Brush.AccentPrimary}"
               FontSize="16"
               FontWeight="SemiBold"
               Text="{Binding TournamentName}" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                   FontSize="12"
                   Text="{StaticResource Tournament_StatusLabel}" />
                    <TextBlock Margin="6,0,0,0"
                   Foreground="{StaticResource Brush.AccentPrimary}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Text="{Binding StatusDisplay}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0"
               Foreground="{StaticResource Brush.TextSecondary}"
               FontSize="12"
               Text="{Binding StatusMessage}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TournamentCardBorder}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource Brush.AccentPrimary}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                                </Grid>
                                <StackPanel Margin="0,12,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock
                                        Foreground="{StaticResource Brush.TextPrimary}"
                                        FontSize="12"
                                        Text="{Binding PitchName}" />
                                    <TextBlock Margin="8,0,0,0"
                                        Foreground="{StaticResource Brush.TextPrimary}"
                                        FontSize="14"
                                        Text="{Binding HomeTeamName}" />
                                    <TextBlock Margin="6,0,0,0"
                                        Foreground="{StaticResource Brush.TextPrimary}"
                                        FontSize="14"
                                        Text="{Binding AwayTeamName}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
