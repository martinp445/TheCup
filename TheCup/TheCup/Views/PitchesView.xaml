<UserControl x:Class="TheCup_Presentation.Views.PitchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SectionTitle}"
                       Text="{StaticResource Pitches_Title}" />
            <TextBlock Style="{StaticResource SectionSubtitle}"
                       Text="{StaticResource Pitches_Subtitle}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource Brush.AccentPrimary}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding TournamentName}" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                           FontSize="12"
                           Text="{StaticResource Tournament_StatusLabel}" />
                <TextBlock Margin="6,0,0,0"
                           Foreground="{StaticResource Brush.AccentPrimary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding StatusDisplay}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       FontSize="12"
                       Text="{Binding ActivationHint}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,16"
                Style="{StaticResource TournamentCardBorder}"
                Padding="16"
                Visibility="{Binding ShowActivateSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}"
                           FontSize="18"
                           Text="{StaticResource Tournament_ActivateTitle}" />
                <TextBlock Margin="0,6,0,16"
                           Style="{StaticResource SectionSubtitle}"
                           Text="{StaticResource Groups_StartMessage}" />
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButton}"
                        Content="{StaticResource Tournament_Activate}"
                        Command="{Binding ActivateTournamentCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,16"
                Style="{StaticResource TournamentCardBorder}"
                Padding="16"
                Visibility="{Binding ShowActiveBanner, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="{StaticResource Brush.AccentPrimary}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{StaticResource Tournament_ActiveBanner}" />
        </Border>

        <Border Grid.Row="3"
                Margin="0,0,0,24"
                Style="{StaticResource TournamentCardBorder}"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="{StaticResource Pitches_NewPitchLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}"
                             IsEnabled="{Binding IsDraft}"
                             Text="{Binding NewPitchName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Margin="0,0,12,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="{StaticResource Pitches_AddPitch}"
                        Command="{Binding AddPitchCommand}" />

                <Button Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryButton}"
                        Content="{StaticResource Pitches_Refresh}"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Pitches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TournamentCardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Style="{StaticResource DarkTextBox}"
                                         IsEnabled="{Binding CanModify}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="{StaticResource Pitches_Rename}"
                                        Command="{Binding CommitRenameCommand}" />

                                <Button Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DangerButton}"
                                        Content="{StaticResource Pitches_Remove}"
                                        Command="{Binding RemovePitchCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
