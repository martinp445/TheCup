<Window x:Class="TheCup_Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{StaticResource App_Title}"
        MinHeight="600"
        MinWidth="960"
        Height="720"
        Width="1200"
        Background="{StaticResource Brush.BackgroundPrimary}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Brush.BackgroundSurface}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="8"
                        BorderBrush="{StaticResource Brush.AccentPrimary}"
                        BorderThickness="2"
                        Effect="{StaticResource Effect.AccentGlow}">
                    <TextBlock Text="TC"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.AccentPrimary}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{StaticResource App_Title}"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12"
                               Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{StaticResource Home_Subtitle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveTournament}" Value="True">
                                        <Setter Property="Text"
                                                Value="{Binding ActiveTournamentName, StringFormat={}{0}}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.AccentPrimary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        Content="{StaticResource Home_NewTournament}"
                        Command="{Binding Home.NewTournamentCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Brush.BackgroundSurface}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                    BorderThickness="0,0,1,0">
                <ListBox Style="{StaticResource NavListBox}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         SelectedIndex="{Binding SelectedNavIndex}">
                    <ListBoxItem Content="{StaticResource Nav_Overview}" />
                    <ListBoxItem Content="{StaticResource Nav_Teams}"
                                 IsEnabled="{Binding IsTournamentNavEnabled}" />
                    <ListBoxItem Content="{StaticResource Nav_Pitches}"
                                 IsEnabled="{Binding IsTournamentNavEnabled}" />
                    <ListBoxItem Content="{StaticResource Nav_Groups}"
                                 IsEnabled="{Binding IsGroupsNavEnabled}"
                                 ToolTip="{StaticResource Nav_DisabledGroupsTooltip}" />
                    <ListBoxItem Content="{StaticResource Nav_Matches}"
                                 IsEnabled="False"
                                 ToolTip="{StaticResource Nav_DisabledTooltip}" />
                    <ListBoxItem Content="{StaticResource Nav_Playoffs}"
                                 IsEnabled="False"
                                 ToolTip="{StaticResource Nav_DisabledTooltip}" />
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentContent}" />
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource Brush.BackgroundSurface}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource ErrorText}"
                           Text="{Binding StatusMessage}" />

                <ProgressBar Grid.Column="1"
                             Width="120"
                             Height="6"
                             IsIndeterminate="True"
                             Visibility="{Binding IsStatusBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
