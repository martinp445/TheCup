<Application x:Class="TheCup_Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TheCup_Presentation.Views"
             xmlns:vm="clr-namespace:TheCup_Application.ViewModels;assembly=TheCup_Application"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Strings.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:TournamentHomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreateTournamentViewModel}">
                <views:CreateTournamentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TeamsViewModel}">
                <views:TeamsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PitchesViewModel}">
                <views:PitchesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
                <views:GroupsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GamesViewModel}">
                <views:GamesView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
