<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.BackgroundPrimary">#0A0A0A</Color>
    <Color x:Key="Color.BackgroundSurface">#141414</Color>
    <Color x:Key="Color.BackgroundElevated">#1E1E1E</Color>
    <Color x:Key="Color.AccentPrimary">#A4FF00</Color>
    <Color x:Key="Color.AccentMuted">#C0CA33</Color>
    <Color x:Key="Color.TextPrimary">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#B0B0B0</Color>
    <Color x:Key="Color.Danger">#C62828</Color>
    <Color x:Key="Color.BorderSubtle">#2A2A2A</Color>

    <SolidColorBrush x:Key="Brush.BackgroundPrimary" Color="{StaticResource Color.BackgroundPrimary}" />
    <SolidColorBrush x:Key="Brush.BackgroundSurface" Color="{StaticResource Color.BackgroundSurface}" />
    <SolidColorBrush x:Key="Brush.BackgroundElevated" Color="{StaticResource Color.BackgroundElevated}" />
    <SolidColorBrush x:Key="Brush.AccentPrimary" Color="{StaticResource Color.AccentPrimary}" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />

    <DropShadowEffect x:Key="Effect.AccentGlow"
                      Color="{StaticResource Color.AccentPrimary}"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Opacity="0.35" />

</ResourceDictionary>
